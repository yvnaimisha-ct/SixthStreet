{
  "id": "taxonomySet",
  "name": "Taxonomy Set",
  "displayField": "title",
  "description": "A set of taxonomy terms (includes controlled-value sets).",
  "fields": [
    {
      "id": "title",
      "name": "Title",
      "type": "Symbol",
      "required": true
    },
    {
      "id": "key",
      "name": "Key",
      "type": "Symbol",
      "required": true
    },
    {
      "id": "description",
      "name": "Description",
      "type": "Text",
      "required": false
    },
    {
      "id": "allowedContentTypes",
      "name": "Allowed Content Types",
      "type": "Array",
      "required": false,
      "items": {
        "type": "Symbol",
        "validations": {
          "regexp": "^[a-z][a-z0-9]*([A-Z][a-z0-9]+)*$"
        }
      }
    }
  ]
}
