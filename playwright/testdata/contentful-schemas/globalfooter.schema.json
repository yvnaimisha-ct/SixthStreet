{
  "id": "globalFooter",
  "name": "Global Footer",
  "description": "Site-wide footer with logo, navigation links, and legal disclosure",
  "displayField": "internalName",
  "fields": [
    {
      "id": "internalName",
      "name": "Internal Name",
      "type": "Symbol",
      "required": true
    },
    {
      "id": "logo",
      "name": "Logo",
      "type": "Link",
      "required": true,
      "linkType": "Entry",
      "validations": {
        "linkContentType": ["imageWrapper"]
      }
    },
    {
      "id": "primaryLinks",
      "name": "Primary Links",
      "type": "Array",
      "required": true,
      "items": {
        "type": "Link",
        "linkType": "Entry",
        "validations": {
          "linkContentType": ["internalLink"]
        }
      }
    },
    {
      "id": "secondaryLinks",
      "name": "Secondary Links",
      "type": "Array",
      "required": true,
      "items": {
        "type": "Link",
        "linkType": "Entry",
        "validations": {
          "linkContentType": ["internalLink"]
        }
      }
    },
    {
      "id": "disclosure",
      "name": "Disclosure",
      "type": "RichText",
      "required": true,
      "validations": {
        "enabledNodeTypes": ["paragraph", "hyperlink"],
        "enabledMarks": []
    }
    }
  ]
}
